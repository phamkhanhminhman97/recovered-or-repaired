diff --git a/sregym/conductor/conductor.py b/sregym/conductor/conductor.py
index afe0320..d2b45b1 100644
--- a/sregym/conductor/conductor.py
+++ b/sregym/conductor/conductor.py
@@ -394,6 +394,19 @@ class Conductor:
             self.logger.exception("Mitigation oracle raised; recording as failure to avoid a stuck stage.")
             # Keep the existing top-level error field for result consumers.
             r = {**Oracle.fail_from_exception(e), "error": f"{type(e).__name__}: {e}"}
+        # thesis-selfheal-agent WP2: rounds 2 and 3 on the state the agent left, before teardown (opt-in via env)
+        gate = __import__("os").environ.get("SELFHEAL_GATE")
+        if gate and r.get("success"):
+            import subprocess
+            import sys
+
+            try:
+                proc = subprocess.run([sys.executable, gate, self.problem_id, "post"],
+                                      capture_output=True, text=True, timeout=1800)
+                r["selfheal_rounds"] = [json.loads(x) for x in proc.stdout.splitlines() if x.startswith("{")]
+                r["selfheal_rounds_rc"] = proc.returncode
+            except subprocess.TimeoutExpired:
+                r["selfheal_rounds_rc"] = "timeout"
         self.logger.info(
             f"[EVAL] Mitigation {'Succeed' if r.get('success') else 'Failed'}\n "
             f"TTM: {time.time() - self.execution_start_time}"
