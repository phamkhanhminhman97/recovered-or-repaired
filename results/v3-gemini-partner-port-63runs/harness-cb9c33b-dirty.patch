+def transcript_calls(files):
+    """Moi loi goi cong cu trong ban ghi phien cua agent va subagent: exec, MCP, subagent, tim web, apply_patch.
+    (Su kien --json chi co lenh shell cua luong chinh; truoc 2026-11-06 MCP/subagent/tim web chi ghi loai.)"""
+    calls = []
+    for f in files:
+        thread = Path(f).stem[-12:]
+        with open(f, errors="ignore") as fh:
+            for line in fh:
+                try:
+                    e = json.loads(line)
+                except json.JSONDecodeError:
+                    continue
+                p = e.get("payload")
+                if e.get("type") != "response_item" or not isinstance(p, dict):
+                    continue
+                t = p.get("type")
+                if t == "function_call":
+                    calls.append({"thread": thread, "name": p.get("name"), "args": str(p.get("arguments"))[:4000]})
+                elif t == "custom_tool_call":
+                    calls.append({"thread": thread, "name": p.get("name"), "args": str(p.get("input"))[:4000]})
+                elif t == "web_search_call":
+                    calls.append({"thread": thread, "name": "web_search",
+                                  "args": json.dumps(p.get("action"), ensure_ascii=False)[:4000]})
+    return calls
+
+
+def scan_targets(commands, tool_calls):
+    """Lenh shell + moi loi goi cong cu khac, de quet peek/partner_inspect. apply_patch chi xet duong dan file
+    (noi dung code agent viet khong phai la lenh doc)."""
+    out = list(commands)
+    for c in tool_calls:
+        if c["name"] == "apply_patch":
+            text = " ".join(l for l in c["args"].splitlines() if l.startswith("*** ") and "File:" in l)
+        else:
+            text = f'{c["name"]} {c["args"]}'
+        out.append({"command": text})
+    return out
+
+
+def exec_commands(commands, tool_calls):
+    """Lenh shell cua luong chinh + lenh exec cua subagent (de phan loai hanh dong van hanh)."""
+    return list(commands) + [{"command": c["args"]} for c in tool_calls if c["name"] == "exec_command"]
+
