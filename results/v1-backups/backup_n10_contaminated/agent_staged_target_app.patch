+// DLQ worker -- replay messages khi fault duoc fix
+async function processDlqJob(job) {
+  // Only replay if fault is fixed, otherwise just keep in DLQ
+  if (!FAULT_FIXED) {
+    throw new Error("F4: fault not fixed yet, keeping message in DLQ");
+  }
+  
+  // Replay DLQ message: add it back to main queue voi attempt count reset
+  try {
+    await jobQueue.add("job", job.data || {}, {
+      attempts: 3,
+      backoff: { type: "fixed", delay: 200 },
+    });
+  } catch (e) {
+    throw e;
+  }
+}
+
+const dlqWorker = new Worker("jobs-dlq", processDlqJob, {
+  connection,
+  concurrency: 5,
+});
+
+dlqWorker.on("completed", async (job) => {
+  if (job) {
